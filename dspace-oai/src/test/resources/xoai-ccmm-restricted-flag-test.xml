<!--
    A PUB-licensed item with files that nevertheless carries others/restrictedAccess, which
    ItemUtils sets when a bitstream licence demands the identity form.  The flag outranks the
    licence category: the item is not freely downloadable.
-->
<metadata xmlns="http://www.lyncode.com/xoai">
    <element name="dc">
        <element name="date">
            <element name="issued">
                <element name="none">
                    <field name="value">2020-04-01</field>
                </element>
            </element>
        </element>
        <element name="rights">
            <element name="none">
                <field name="value">Creative Commons - Attribution 4.0 International</field>
            </element>
            <element name="label">
                <element name="none">
                    <field name="value">PUB</field>
                </element>
            </element>
        </element>
        <element name="title">
            <element name="none">
                <field name="value">A Gated Public Resource</field>
            </element>
        </element>
    </element>
    <element name="bundles">
        <element name="bundle">
            <field name="name">ORIGINAL</field>
            <element name="bitstreams">
                <element name="bitstream">
                    <field name="name">data.zip</field>
                    <field name="format">application/zip</field>
                    <field name="size">8192</field>
                    <field name="url">https://repository.example.org/repository/bitstream/1/4/data.zip</field>
                </element>
            </element>
        </element>
    </element>
    <element name="others">
        <field name="handle">123456789/1-11</field>
        <field name="identifier">oai:repository.example.org:123456789/1-11</field>
        <field name="anonymousAccess">restricted</field>
        <field name="restrictedAccess">true</field>
        <element name="access-status">
            <field name="value">open.access</field>
        </element>
    </element>
    <element name="repository">
        <field name="name">Example Repository</field>
        <field name="url">https://repository.example.org/repository/</field>
    </element>
</metadata>
